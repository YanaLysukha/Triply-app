{
  "name": "Triply-app",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "jest": "^30.5.2"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-trips": "cds watch --open my.travel.trips/index.html?sap-ui-xx-viewCache=false --livereload false",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa",
        "db": "hana"
      },
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "alice": {
              "roles": [
                "viewer"
              ]
            },
            "admin": {
              "roles": [
                "admin",
                "viewer"
              ]
            }
          }
        }
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/trips"
  ]
}
